[Desktop Entry]
Name=Jellyfin MPV Play
Comment=Play media from Jellyfin using MPV
Version=1.0
Exec=env bash -c 'for d in "$HOME/JellyfinMPVPlay-Linux-"* /opt/jellyfin-mpv-play; do [ -x "$d/launch.sh" ] && exec "$d/launch.sh"; done; echo "launch.sh not found. Extract the bundle and update the Exec path in this .desktop file." >&2; sleep 3;'
Icon=jellyfin-mpv-play
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;
Keywords=jellyfin;mpv;video;media;

Actions=Headless;InstallService;UninstallService;

[Desktop Action Headless]
Name=Run Headless
Exec=env bash -c 'for d in "$HOME/JellyfinMPVPlay-Linux-"* /opt/jellyfin-mpv-play; do [ -x "$d/launch.sh" ] && exec "$d/launch.sh" --headless; done'
Terminal=false

[Desktop Action InstallService]
Name=Install Background Service
Exec=env bash -c 'for d in "$HOME/JellyfinMPVPlay-Linux-"* /opt/jellyfin-mpv-play; do [ -x "$d/launch.sh" ] && exec "$d/launch.sh" --install-service; done'
Terminal=true

[Desktop Action UninstallService]
Name=Remove Background Service
Exec=env bash -c 'for d in "$HOME/JellyfinMPVPlay-Linux-"* /opt/jellyfin-mpv-play; do [ -x "$d/launch.sh" ] && exec "$d/launch.sh" --uninstall-service; done'
Terminal=true
